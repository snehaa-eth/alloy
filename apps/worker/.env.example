# ---- chain ----
RPC_URL=https://sepolia.base.org            # comma-separated = fallback list (use a paid RPC in prod)
CHAIN_ID=84532
# ALLOY_FACTORY= / ALLOY_ROUTER= / START_BLOCK=   # default: @alloy/sdk deployments (84532)

# ---- indexer (Ponder) ----
DATABASE_URL=                                # Railway Postgres; empty = PGlite in .ponder/ (dev only)
DATABASE_SCHEMA=alloy                        # bump (alloy_v2…) on schema changes for zero-downtime reindex
NAV_SNAPSHOT_BLOCKS=1800                     # 1h on Base
# REORG_WINDOW=0                             # ONLY for a local anvil fork
CORS_ORIGINS=*
ADMIN_TOKEN=                                 # bearer for POST /v1/admin/price-sync

# ---- keeper ----
KEEPER_PK=                                   # factory.keeper() key. Secret. Keep <= 0.02 ETH on it.
# KEEPER_ADDRESS=                            # instead of KEEPER_PK on an unlocked local node
DRY_RUN=false
KEEPER_INTERVAL_SEC=60
KEEPER_MARGIN_BPS=20                         # aim this far inside the band edge
KEEPER_MIN_TRADE_USD=1
KEEPER_GAS_MULTIPLIER=2
ACCRUE_EVERY_DAYS=7
# KEEPER_MODES={"0xBasket…":"trend"}        # overrides config/modes.json
# TREND_MIN_DAYS=20

# ---- alerts (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_INFO=false                             # also send successful rebalances

# ---- price-sync (testnet only) ----
RUN_PRICE_SYNC=true
PRICE_SYNC_MODE=mirror                       # mirror | hold | off  (runtime override: POST /v1/admin/price-sync)
PRICE_SYNC_INTERVAL_MIN=5
PRICE_BOT_PK=                                # testnet-env bot key (MINT_ROLE + feed updater). Secret.

# ---- process toggles ----
RUN_INDEXER=true
RUN_KEEPER=true
