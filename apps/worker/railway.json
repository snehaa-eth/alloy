{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": ["apps/worker/**", "packages/sdk/**", "packages/testnet-env/bot/**", "packages/testnet-env/deployments/**"]
  },
  "deploy": {
    "startCommand": "node --import tsx services/main.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
