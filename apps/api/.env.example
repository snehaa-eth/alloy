# Alloy API v2. Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Mongo (text only: basket theses, rebalance reasons, AI proposals, waitlist)
MONGO_URI=

# RPC endpoints (optional; viem falls back to the chain's public RPC)
RPC_URL_BASE=
RPC_URL_BASE_SEPOLIA=

# Comma-separated chain ids this deployment serves. First one is the default. Supported: 8453, 84532
CHAIN_IDS=8453,84532

# Comma-separated list of exact web origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000,https://crates-ui.vercel.app

# Privy (server-side verification of access tokens)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Comma-separated waitlist invite codes
INVITE_CODES=

# Shared secret for machine callers (AI agent / cron), sent as "Authorization: Bearer <CRON_SECRET>". Min 32 chars.
CRON_SECRET=

# Optional: path to the Base Sepolia test-stock deployments JSON (from packages/testnet-env)
TESTNET_DEPLOYMENTS_PATH=
